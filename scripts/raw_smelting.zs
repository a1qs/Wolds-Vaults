// adding recipes

import crafttweaker.api.recipe.FurnaceRecipeManager;

furnace.addRecipe("raw2blockchromatic", <item:the_vault:chromatic_iron_block>, <item:the_vault:raw_chromatic_iron_block>, 1.0, 200);

furnace.addRecipe("raw2blockzinc", <item:create:zinc_block>, <item:create:raw_zinc_block>, 1.0, 200);

furnace.addRecipe("raw2blockgold", <item:minecraft:gold_block>, <item:minecraft:raw_gold_block>, 1.0, 200);

furnace.addRecipe("raw2blockcopper", <item:minecraft:copper_block>, <item:minecraft:raw_copper_block>, 1.0, 200);

furnace.addRecipe("raw2blockiron", <item:minecraft:iron_block>, <item:minecraft:raw_iron_block>, 1.0, 200);